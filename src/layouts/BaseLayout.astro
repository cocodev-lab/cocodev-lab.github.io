---
import Header from '../components/Header.astro';
import Affiliations from '../components/Affiliations.astro';
import { site } from '../data/site';
import '../styles/main.scss';

interface Props { title: string; description?: string; bodyClass?: string; }
const { title, description = site.description, bodyClass = '' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title === 'Home' ? 'CoCoDev — Computational Communicative Development' : `${title} — CoCoDev`}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title === 'Home' ? site.fullName : title} — CoCoDev`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/assets/images/logoCocodev.png', Astro.site)} />
  </head>
  <body class:list={['wide', title === 'Home' ? 'layout--home' : 'layout--archive', bodyClass]}>
    <ul class="skip-link">
      <li><a class="screen-reader-shortcut" href="#site-nav">Skip to navigation</a></li>
      <li><a class="screen-reader-shortcut" href="#content">Skip to content</a></li>
      <li><a class="screen-reader-shortcut" href="#footer">Skip to footer</a></li>
    </ul>
    <Header />
    <div class="initial-content">
      <main id="main" class="site-layout">
        <article id="content" class="archive" tabindex="-1">
          {title !== 'Home' && <h1 id="page-title" class="page__title">{title}</h1>}
          <slot />
        </article>
      </main>
    </div>
    <div id="footer" class="page__footer">
      <footer><div class="page__footer-copyright">© 2026 CoCoDev. Design adapted from <a href="https://mademistakes.com/work/minimal-mistakes-jekyll-theme/">Minimal Mistakes</a>.</div><Affiliations /></footer>
    </div>
  </body>
</html>
