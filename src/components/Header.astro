---
import { navigation } from '../data/site';
const path = Astro.url.pathname;
---
<header class="masthead">
  <div class="masthead__inner-wrap">
    <div class="masthead__menu">
      <nav id="site-nav" class="greedy-nav" aria-label="Primary navigation">
        <a class="site-logo" href="/" aria-label="CoCoDev home"><img src="/assets/images/logoCocodev.png" alt="CoCoDev" width="1032" height="242" /></a>
        <ul class="visible-links">
          {navigation.map(({ label, href }) => <li class="masthead__menu-item"><a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a></li>)}
        </ul>
        <button class="greedy-nav__toggle" type="button" aria-expanded="false" aria-controls="overflow-navigation" hidden>
          <span class="visually-hidden">More navigation</span><div class="navicon"></div>
        </button>
        <ul id="overflow-navigation" class="hidden-links" hidden></ul>
      </nav>
    </div>
  </div>
</header>
<script>
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const visible = nav?.querySelector<HTMLUListElement>('.visible-links');
  const overflow = nav?.querySelector<HTMLUListElement>('.hidden-links');
  const toggle = nav?.querySelector<HTMLButtonElement>('button');
  if (nav && visible && overflow && toggle) {
    const items = Array.from(visible.children);
    const closeMenu = () => {
      overflow.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.classList.remove('close');
    };
    const resize = () => {
      closeMenu();
      visible.append(...items);
      toggle.hidden = true;
      if (visible.scrollWidth > visible.clientWidth) {
        toggle.hidden = false;
        while (visible.scrollWidth > visible.clientWidth && visible.lastElementChild) {
          overflow.prepend(visible.lastElementChild);
        }
      }
    };
    nav.dataset.enhanced = 'true';
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      overflow.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.classList.toggle('close', open);
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !nav.contains(event.target)) closeMenu();
    });
    nav.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { closeMenu(); toggle.focus(); }
    });
    const observer = new ResizeObserver(resize);
    observer.observe(nav);
    nav.querySelector('img')?.addEventListener('load', resize);
    document.fonts.ready.then(resize);
    resize();
  }
</script>
