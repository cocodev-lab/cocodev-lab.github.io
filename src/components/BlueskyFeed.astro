<div class="bluesky-feed" data-bluesky-feed>
  <p><a href="https://bsky.app/profile/fourtassi.bsky.social">@fourtassi.bsky.social on Bluesky</a></p>
  <p class="metadata" role="status" data-feed-status hidden>Loading recent posts…</p>
  <iframe title="Recent Bluesky posts by Abdellah Fourtassi" height="400" sandbox="allow-popups allow-popups-to-escape-sandbox" referrerpolicy="no-referrer" data-feed-frame hidden></iframe>
  <noscript><p>Read recent posts using the Bluesky profile link above.</p></noscript>
</div>
<script>
  async function loadFeed(container: HTMLElement) {
    const frame = container.querySelector<HTMLIFrameElement>('[data-feed-frame]');
    const status = container.querySelector<HTMLElement>('[data-feed-status]');
    if (!frame || !status) return;
    status.hidden = false;
    try {
      const url = 'https://embedbsky.com/feeds/1639785d5879331a15665bbe078a3c16f9814a353bf9e40b3869846443a91513.html';
      const response = await fetch(url, { signal: AbortSignal.timeout(10000) });
      if (!response.ok) throw new Error('Feed unavailable');
      const html = await response.text();
      if (!html.trim()) throw new Error('Empty feed');
      // Keep the existing embed isolated from site styles and scripts.
      frame.srcdoc = `<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="https://embedbsky.com/embedbsky.com-master-min.css"><style>html,body{margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}#embedbsky-com-timeline-embed{width:100%;max-width:100%;height:auto;box-sizing:border-box}</style></head><body><div id="embedbsky-com-timeline-embed">${html}</div></body></html>`;
      frame.hidden = false;
      status.hidden = true;
    } catch {
      status.textContent = 'The feed could not be loaded. You can read the posts on Bluesky using the link above.';
    }
  }
  document.querySelectorAll<HTMLElement>('[data-bluesky-feed]').forEach(container => {
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        if (entries.some(entry => entry.isIntersecting)) {
          observer.disconnect();
          void loadFeed(container);
        }
      }, { rootMargin: '200px' });
      observer.observe(container);
    } else {
      void loadFeed(container);
    }
  });
</script>
