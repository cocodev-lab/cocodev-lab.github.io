---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecentUpdates from '../components/RecentUpdates.astro';
import { groupNews } from '../data/news';
---
<BaseLayout title="Home">
  <div class="home-page">
    <h1 class="home-banner"><img src="/assets/images/cocodev-banner.jpg" alt="CoCoDev — Computational Communicative Development" width="1500" height="500" fetchpriority="high" /></h1>
    <div class="home-intro">
      <p>CoCoDev is a research group at Aix-Marseille University. We study how multimodal interaction shapes language and communicative development. Computational models are central to our research. We use them to build and test theories of learning over developmental timescales—using data from children’s everyday perceptual and social experience.</p>
    </div>
    <RecentUpdates audience="group" items={groupNews} showByline={false} moreHref="/news/" />
  </div>
</BaseLayout>
